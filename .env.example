# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Gemma 4 models (Gemini API)
WORKER_MODEL=gemma-4-26b-a4b-it
MANAGER_MODEL=gemma-4-31b-it

# Local default is SQLite. On DigitalOcean use Managed PostgreSQL:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:25060/defaultdb?sslmode=require
DATABASE_URL=sqlite:///pipelineiq.db

# RAG embeddings: gemini (default) | local (EmbeddingGemma, open weights, needs sentence-transformers) | hash (offline)
EMBEDDINGS=gemini
RAG_TOP_K=4

# Vector database: chroma (local folder ./chroma_db) | pgvector (PostgreSQL with the pgvector extension)
VECTOR_DB=chroma
# For pgvector on DigitalOcean (defaults to DATABASE_URL if empty):
# VECTOR_DB_URL=postgresql://USER:PASSWORD@HOST:25060/defaultdb?sslmode=require

MAX_REWORK_ATTEMPTS=3
USE_FAKE_LLM=0
